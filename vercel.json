{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://heartmade-lavavel.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://heartmade-lavavel.onrender.com/admin/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://heartmade-lavavel.onrender.com/sanctum/:path*"
    }
  ]
}
